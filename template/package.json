{
  "name": "traveldiary",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "deploy": "npm run build && bash deploy.sh",
    "deploy:web": "bash deploy-web.sh",
    "build:single": "node scripts/build-single.mjs",
    "preview": "vite preview",
    "data": "node scripts/build-content.mjs && node scripts/build-tracks.mjs && node scripts/build-timeline.mjs && node scripts/fetch-pois.mjs && node scripts/build-photos.mjs",
    "data:content": "node scripts/build-content.mjs",
    "data:tracks": "node scripts/build-tracks.mjs",
    "data:photos": "node scripts/build-photos.mjs",
    "data:timeline": "node scripts/build-timeline.mjs",
    "data:pois": "node scripts/fetch-pois.mjs",
    "setup": "node setup/server.mjs"
  },
  "dependencies": {
    "maplibre-gl": "^4.7.1",
    "marked": "^14.1.4"
  },
  "devDependencies": {
    "@tmcw/togeojson": "^5.8.1",
    "@xmldom/xmldom": "^0.8.10",
    "exifr": "^7.1.3",
    "puppeteer-core": "^25.13.0",
    "sharp": "^0.33.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
